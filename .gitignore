# --- Stage-5 baseline exclusions ---

# Root Node deps (Playwright/E2E harness tooling); generated per machine.
# (extension/ and tests/e2e-extension/ node_modules are already covered above.)
/node_modules/

# Playwright run artifacts emitted at repo root.
/test-results/

# Redirected pytest console output used for local debugging; not source.
backend/pytest_output.txt
backend/pytest_output_utf8.txt
backend/pytest_final_output.txt
backend/pytest_final_output_utf8.txt
backend/pytest_results.txt

