# Model binaries stay out of git (no LFS decision made).
# Note: already-tracked files in this dir are unaffected.
ml-retrain/models/*.onnx

# E2E SPEC files intentionally stay out per README design rule
# (fixtures/ and fixtures/pages/ ARE committed — do not exclude them).
tests/e2e-extension/[0-9][0-9]-*.spec.js

# Agent orchestration runtime state; machine-local.
.claude-flow/
